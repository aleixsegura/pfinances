# Copy to .env and fill in. One KEY=value per line; .env is gitignored.

# DEGIRO (export_degiro.py)
DEGIRO_USERNAME=
DEGIRO_PASSWORD=
# Optional: skips the client-details call when present.
DEGIRO_INT_ACCOUNT=

# export_revolut.py needs no keys — it drives the Revolut web app and prices
